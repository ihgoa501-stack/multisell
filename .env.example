# ============================================
# MultiSell Environment Configuration
# ============================================
# Copy this file to .env and fill in production values.
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# Production secrets must be set outside the repo (CI secrets, Docker secrets,
# or your orchestration platform's env management).

APP_NAME=MultiSell - AI跨境电商商品中台
APP_VERSION=2.0.0
DEBUG=True
APP_PORT=8001

# ============================================
# Database  (Legacy Python backend -- frozen)
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_management
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/product_management
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_management_test

# ============================================
# Database  (Active Go backend)
# ============================================
# Production: set DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
# instead of duplicating credentials here.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multisell
DB_SSLMODE=disable

# ============================================
# Authentication & Secrets
# ============================================

# JWT signing secret -- required by the Go backend.
# Production: generate with `openssl rand -base64 64` and keep secure.
JWT_SECRET=dev-secret-change-in-production

# Platform token encryption key (AES-256-GCM, 32 bytes, base64-encoded).
# Used by domain/integrations to encrypt OAuth / API tokens at rest.
# Production: generate with `openssl rand -base64 32`
PLATFORM_TOKEN_ENCRYPTION_KEY=

# Legacy Python encryption key (frozen stack, kept for reference).
ENCRYPTION_KEY=change-me-to-a-random-32-byte-secret

AUTH_ENABLED=True

# ============================================
# AI / LLM
# ============================================

# LLM API key -- required in production (the process will fail to start
# if LLM_API_KEY is empty when server.mode is "release").
LLM_API_KEY=

# LLM provider and model selection.
LLM_PROVIDER=openai   # openai | anthropic | stub (stub = no real model calls)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# ============================================
# Uploads & Static
# ============================================
UPLOAD_DIR=./uploads
STATIC_URL=/static
