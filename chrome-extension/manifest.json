{
  "manifest_version": 3,
  "name": "LingMirror Sourcing Agent",
  "version": "0.1.0",
  "description": "LingMirror AI sourcing extension — collect and analyze 1688 product data for cross-border e-commerce",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://detail.1688.com/*",
    "https://www.1688.com/*"
  ],
  "background": {
    "service_worker": "build/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/offer/*"],
      "js": ["build/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LingMirror Sourcing"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
