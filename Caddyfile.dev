# LingMirror Development Caddyfile
# HTTP only, no TLS — for local development.
#
# Usage (standalone):
#   caddy run --config Caddyfile.dev
#
# Or through Docker Compose (add caddy to the dev services):
#   docker compose -f docker-compose.yml -f docker-compose.dev-caddy.yml up -d

{
    # Disable automatic TLS for local development
    auto_https off
}

:80 {
    # ── WebSocket endpoint ──────────────────────────────────────────
    # Backend serves WebSocket at /ws
    handle /ws {
        reverse_proxy backend:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── API routes -> backend ──────────────────────────────────────
    # NOTE: The Go backend serves routes WITH the /api prefix
    # (e.g. /api/health, /api/v1/...). Keep the prefix intact.
    handle /api/* {
        reverse_proxy backend:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Everything else -> frontend (Next.js) ──────────────────────
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
