{
  "title": "LingMirror — API Overview",
  "uid": "lingmirror-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["lingmirror", "production"],
  "panels": [
    {
      "title": "QPS",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 0, "y": 0 },
      "targets": [{
        "expr": "rate(multisell_http_requests_total[1m])",
        "legendFormat": "req/s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 100 }
          ]}
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 3, "y": 0 },
      "targets": [{
        "expr": "rate(multisell_http_requests_total{status=~\"5..\"}[5m]) / rate(multisell_http_requests_total[5m])",
        "legendFormat": "error %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.02 },
            { "color": "red", "value": 0.05 }
          ]}
        }
      }
    },
    {
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 6, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(multisell_http_request_duration_ms_bucket[5m]))",
        "legendFormat": "p95 ms"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 2000 }
          ]}
        }
      }
    },
    {
      "title": "Concurrent Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 9, "y": 0 },
      "targets": [{
        "expr": "multisell_http_concurrent_requests",
        "legendFormat": "concurrent"
      }]
    },
    {
      "title": "Request Rate (1m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(multisell_http_requests_total{status=\"2xx\"}[1m])", "legendFormat": "2xx" },
        { "expr": "rate(multisell_http_requests_total{status=\"4xx\"}[1m])", "legendFormat": "4xx" },
        { "expr": "rate(multisell_http_requests_total{status=\"5xx\"}[1m])", "legendFormat": "5xx" }
      ]
    },
    {
      "title": "P99/P95/P50 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(multisell_http_request_duration_ms_bucket[5m]))", "legendFormat": "p99" },
        { "expr": "histogram_quantile(0.95, rate(multisell_http_request_duration_ms_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.50, rate(multisell_http_request_duration_ms_bucket[5m]))", "legendFormat": "p50" }
      ]
    },
    {
      "title": "GC Pressure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [{
        "expr": "go_memstats_next_gc_bytes / go_memstats_heap_alloc_bytes",
        "legendFormat": "next_gc / heap_alloc"
      }]
    },
    {
      "title": "Event Bus — DLQ Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [{
        "expr": "multisell_eventbus_queue_depth{topic=\"dlq\"}",
        "legendFormat": "dlq"
      }]
    }
  ]
}
