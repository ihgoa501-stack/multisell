# ============================================
# MultiSell Environment Configuration
# ============================================
# Copy this file to .env and fill in production values.
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# Production secrets must be set outside the repo (CI secrets, Docker secrets,
# or your orchestration platform's env management).

APP_NAME=MultiSell - AI跨境电商商品中台
APP_VERSION=2.0.0
DEBUG=True
APP_PORT=8001

# ============================================
# Database  (Legacy Python backend -- frozen)
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_management
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/product_management
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_management_test

# ============================================
# Database  (Active Go backend)
# ============================================
# Production: set DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
# instead of duplicating credentials here.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multisell
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_SSLMODE=disable

# Active Go HTTP server safety bounds. Write timeout stays disabled because
# streaming responses use operation-level context deadlines.
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=0s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_MAX_HEADER_BYTES=1048576
SERVER_MAX_REQUEST_BODY_BYTES=33554432
SWAGGER_ENABLED=true

# Internal Owner-only product image execution service.
IMAGE_SERVICE_BASE_URL=http://127.0.0.1:8092
IMAGE_SERVICE_SHARED_SECRET=dev-image-service-secret
IMAGE_SERVICE_EXECUTION_TOKEN_SECRET=replace-with-an-independent-random-secret-at-least-32-bytes
# Image Service job/attempt/nonce database. Production and acceptance reject
# the file store; use a least-privilege PostgreSQL credential here.
IMAGE_SERVICE_ENVIRONMENT=development
IMAGE_SERVICE_JOB_STORE=postgres
IMAGE_SERVICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multisell?sslmode=disable

# ============================================
# Authentication & Secrets
# ============================================

# JWT signing secret -- required by the Go backend.
# Production: generate with `openssl rand -base64 64` and keep secure.
JWT_SECRET=dev-secret-change-in-production
JWT_KEY_ID=current
# JSON object used only during a rotation window, for example {"2026-06":"old-secret-at-least-32-characters"}
JWT_PREVIOUS_KEYS_JSON=
AUTH_REGISTRATION_ENABLED=true

# Platform token encryption key (AES-256-GCM, 32 bytes, base64-encoded).
# Used by domain/integrations to encrypt OAuth / API tokens at rest.
# Production: generate with `openssl rand -base64 32`
PLATFORM_TOKEN_ENCRYPTION_KEY=

# Legacy Python encryption key (frozen stack, kept for reference).
ENCRYPTION_KEY=change-me-to-a-random-32-byte-secret

AUTH_ENABLED=True

# ============================================
# AI / LLM
# ============================================

# LLM API key -- optional until an Owner-approved real provider is enabled.
# Empty keeps the provider unavailable/stub; it must never simulate a real call.
LLM_API_KEY=

# LLM provider and model selection.
LLM_PROVIDER=openai   # openai | anthropic | stub (stub = no real model calls)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# ============================================
# Uploads & Static
# ============================================
UPLOAD_DIR=./uploads
STATIC_URL=/static
