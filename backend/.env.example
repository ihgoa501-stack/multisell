# 凌镜 LingMirror — 环境变量模板
# 复制为 .env 并填入真实值

# === 数据库 ===
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/multisell_dev
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/multisell_dev

# === 安全（生产必需）===
# ENCRYPTION_KEY — 用于加密平台 API 密钥等敏感数据
# 生成: python3 -c "import secrets; print(secrets.token_hex(16))"
# ENCRYPTION_KEY=

# === 认证 ===
# AUTH_ENABLED=true

# === LLM / AI ===
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# === AI 生图 ===
# IMAGE_GEN_PROVIDER=replicate
# IMAGE_GEN_MODEL=black-forest-labs/flux-2-pro
# REPLICATE_API_KEY=
# OPENAI_API_KEY=
# REMOVE_BG_API_KEY=
