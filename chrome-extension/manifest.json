{
  "manifest_version": 3,
  "name": "凌镜 AI 选品助手",
  "version": "0.1.0",
  "description": "凌镜跨境电商 AI 选品采集助手 — 一键采集 1688 商品信息",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "http://localhost:8080/*",
    "wss://*.lingmirror.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/*", "https://item.taobao.com/*"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
