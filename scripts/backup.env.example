# 凌镜 LingMirror — 数据库备份配置模板
#
# 使用方式：
#   直接设置环境变量，然后运行脚本：
#   DB_HOST=db DB_PASSWORD=secret ./scripts/backup.sh
#
#   或通过 docker compose 运行：
#   docker compose run --rm backup
#
# =============================================================================

# 数据库连接
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multisell

# 备份文件存储目录
BACKUP_DIR=./backups

# 本地保留天数（超过此天数的旧备份自动删除）
RETENTION_DAYS=7

# 生产环境要求异地备份；只有本地开发可设为 false。
BACKUP_REQUIRE_OFFSITE=true
BACKUP_REQUIRE_IMMUTABLE_OFFSITE=true

# S3 上传：生产 backup 镜像内置 aws-cli，上传后会验证远端对象存在。
BACKUP_S3_BUCKET=
BACKUP_S3_SSE=AES256

# 审计哈希链 checkpoint。生产必须使用与数据库/JWT 不同的随机密钥，
# S3 bucket 应开启 Versioning + Object Lock。
AUDIT_CHECKPOINT_KEY=
AUDIT_CHECKPOINT_S3_URI=
AUDIT_CHECKPOINT_REQUIRE_OFFSITE=true
AUDIT_CHECKPOINT_REQUIRE_IMMUTABLE_OFFSITE=true

# systemd oneshot 失败通知的通用 webhook。
OPS_ALERT_WEBHOOK_URL=
