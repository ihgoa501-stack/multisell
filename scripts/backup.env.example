# 凌镜 LingMirror — 数据库备份配置模板
#
# 使用方式：
#   直接设置环境变量，然后运行脚本：
#   DB_HOST=db DB_PASSWORD=secret ./scripts/backup.sh
#
#   或通过 docker compose 运行：
#   docker compose run --rm backup
#
# =============================================================================

# 数据库连接
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multisell

# 备份文件存储目录
BACKUP_DIR=./backups

# 本地保留天数（超过此天数的旧备份自动删除）
RETENTION_DAYS=7

# S3 上传（可选）：设置后自动将备份同步到 S3
# 需要安装 aws-cli 并配置凭证
BACKUP_S3_BUCKET=
