{
  "manifest_version": 3,
  "name": "凌镜 AI 选品助手",
  "version": "0.1.0",
  "description": "凌镜自用 AI 选品采集助手 — 自动采集 Ozon 与供应商证据",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "https://*.ozon.ru/*",
    "http://localhost:8080/*",
    "wss://*.lingmirror.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/*", "https://item.taobao.com/*"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.1688.com/*", "*://s.1688.com/*", "https://*.ozon.ru/*"],
      "js": ["content-script-list.js"],
      "exclude_matches": ["*://detail.1688.com/offer/*"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
