{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build",
    "sourceMap": true,
    "declaration": false,
    "isolatedModules": true
  },
  "include": [
    "background.ts",
    "content-script.ts",
    "content-script-list.ts",
    "popup.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "build",
    "node_modules"
  ]
}
