[Unit]
Description=LingMirror external audit hash-chain checkpoint
Requires=docker.service
After=docker.service
OnFailure=lingmirror-ops-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/multisell
EnvironmentFile=/etc/lingmirror/ops.env
ExecStart=/usr/bin/docker compose --profile manual -f docker-compose.yml -f docker-compose.prod.yml run --rm audit-checkpoint
TimeoutStartSec=15m
