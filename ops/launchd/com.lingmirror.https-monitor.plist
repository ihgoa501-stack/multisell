<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lingmirror.https-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/lc/multisell/scripts/monitor_ip_https_local.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/lc/Library/Logs/LingMirror/https-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lc/Library/Logs/LingMirror/https-monitor.error.log</string>
</dict>
</plist>
